{
  "name": "drone-design-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multirotor flight simulation and hardware design toolkit",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "stage1": "tsx scripts/stage1.ts",
    "stage2": "tsx scripts/stage2.ts",
    "stage3": "tsx scripts/stage3.ts",
    "stage4": "tsx scripts/stage4.ts",
    "stage5": "tsx scripts/stage5.ts",
    "variantB": "tsx scripts/variant-b.ts",
    "variantC": "tsx scripts/variant-c.ts",
    "city": "tsx scripts/city.ts",
    "budget": "tsx scripts/budget.ts",
    "manual": "tsx scripts/manual-shots.ts",
    "videos": "tsx scripts/videos.ts",
    "report": "tsx scripts/report-index.ts",
    "all": "npm run stage1 && npm run stage2 && npm run stage3 && npm run stage4 && npm run stage5 && npm run report"
  },
  "dependencies": {
    "manifold-3d": "^3.5.4",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "gerber-parser": "^4.2.7",
    "pcb-stackup": "^4.2.8",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
